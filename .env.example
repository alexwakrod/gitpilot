# GitPilot Configuration
# Copy this to .env and fill in your values

# AI Provider: grok, openai, anthropic, ollama
AI_PROVIDER=grok
AI_MODEL=grok-2
AI_TEMPERATURE=0.5

# API Keys (leave blank if using Ollama)
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Personal Access Token (repo scope)
GITHUB_TOKEN=

# Ollama endpoint (default for local)
OLLAMA_BASE_URL=http://localhost:11434